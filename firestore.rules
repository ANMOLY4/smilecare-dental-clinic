rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'anmlzgaming@gmail.com'; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'patientName', 'phoneNumber', 'preferredDate', 'createdAt', 'status'])
        && data.keys().size() == 6
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() > 0 && data.phoneNumber.size() <= 20
        && data.preferredDate is string && data.preferredDate.size() > 0 && data.preferredDate.size() <= 20
        && data.createdAt == request.time
        && data.status is string && data.status.size() <= 20;
    }

    match /bookings/{bookingId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn()
        && isValidId(bookingId)
        && isValidBooking(incoming());
        
      allow update: if isSignedIn() && (
        isAdmin() || 
        (
          existing().userId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().status == 'cancelled' &&
          existing().status != 'cancelled'
        )
      );
      
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }
  }
}
